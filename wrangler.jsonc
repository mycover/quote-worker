{
	"name": "quote",
	"main": "src/worker.js",
	"workers_dev": true,
	"preview_urls": false,
	"compatibility_date": "2024-09-23",
	"kv_namespaces": [
		{
			// No "id": on the first deploy Wrangler automatically provisions a
			// namespace (name derived from the worker and binding) and attaches it
			// as QUOTE_CACHE. This keeps account IDs out of the repository.
			// Note: a local `wrangler deploy` may write the provisioned id back
			// into this file — if so, restore it: `git checkout -- wrangler.jsonc`.
			"binding": "QUOTE_CACHE"
		}
	],
	"triggers": {
		"crons": ["0 * * * *"]
	}
}